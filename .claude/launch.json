{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "web",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "web:dev"],
			"port": 3000
		},
		{
			"name": "web-prod",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["--workspace", "apps/web", "run", "start"],
			"port": 3000
		},
		{
			"name": "api",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "api:dev"],
			"port": 5000
		}
	]
}
