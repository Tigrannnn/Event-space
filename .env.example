API_PORT=5000
# Browser / public API URL. In Docker prod, this is nginx-api (not the Nest container port).
API_URL=http://localhost:5000

FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=event-space-2026
POSTGRES_DB=event_space
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

GOOGLE_CLIENT_ID=google-client-id-from-cloud-console
GOOGLE_CLIENT_SECRET=google-client-secret-from-cloud-console

JWT_ACCESS_SECRET=secret-access-key

ALLOWED_ORIGINS=http://localhost:3000

RESEND_API_KEY=re_resend-code-api-key
MAIL_FROM=email

# SMTP Settings (leave as-is to use dev mode with console logging)
SMTP_HOST=SMTP-host
SMTP_PORT=465
SMTP_USER=SMTP-user
SMTP_PASS=SMTP-password
SMTP_FROM=email

# Set to 'true' to force console logging instead of sending emails
MAIL_DEV_MODE=true

CLOUDINARY_CLOUD_NAME=cloudinary-cloud-name
CLOUDINARY_API_KEY=cloudinary-api-key
CLOUDINARY_API_SECRET=cloudinary-api-secret