generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider              = "zod-prisma-types"
  output                = "../../../packages/shared/src/generated"
  useMultipleFiles      = true
  writeBarrelFiles      = true
  createInputTypes      = true
  createModelTypes      = true
  addSelectQueries      = true
  addIncludeQueries     = true
  prismaJsonNullability = false
  coerceLazyConfig      = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventDifficulty {
  EASY
  MODERATE
  HARD
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum PaymentMethod {
  SITE_PAYMENT
  OFFLINE_PAID
  PAY_ON_ARRIVAL
}

enum Locale {
  en
  ru
  hy
}

model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations CategoryTranslation[]
  events       Event[]

  @@map("categories")
}

model CategoryTranslation {
  id         String @id @default(uuid())
  categoryId String @map("category_id")
  locale     Locale
  name       String @db.VarChar(100)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

model Event {
  id          String           @id @default(uuid())
  locationUrl String?          @map("location_url") @db.VarChar(1000)
  difficulty  EventDifficulty?
  price       Decimal          @db.Decimal(10, 2)
  duration    Int // Minutes

  status EventStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId    String @map("user_id")
  organizer User   @relation("user_events", fields: [userId], references: [id], onDelete: Cascade)

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  occurrences EventOccurrence[] @relation("event_occurrences")

  images EventImage[] @relation("event_images")

  cancellationRules CancellationPolicyRule[] @relation("event_cancellation_rules")

  translations EventTranslation[]

  @@index([categoryId])
  @@map("events")
}

enum EventOccurrenceStatus {
  ACTIVE
  CANCELLED
}

model EventOccurrence {
  id                  String   @id @default(uuid())
  eventId             String   @map("event_id")
  date                DateTime
  status              EventOccurrenceStatus @default(ACTIVE)
  maxParticipants     Int      @default(100) @map("max_participants")
  currentParticipants Int      @default(0) @map("current_participants")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  event    Event     @relation("event_occurrences", fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("occurrence_bookings")

  @@index([date])
  @@index([eventId])
  @@map("event_occurrences")
}

model EventImage {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  url       String   @db.VarChar(1000)
  publicId  String   @unique @map("public_id") @db.VarChar(500)
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation("event_images", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_images")
}

model CancellationPolicyRule {
  id               String @id @default(uuid())
  eventId          String @map("event_id")
  hoursBeforeEvent Int    @map("hours_before_event")
  refundPercentage Int    @map("refund_percentage")

  event Event @relation("event_cancellation_rules", fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, hoursBeforeEvent])
  @@map("cancellation_policy_rules")
}

model EventTranslation {
  id      String @id @default(uuid())
  eventId String @map("event_id")

  locale Locale

  title         String   @db.VarChar(100)
  description   String   @db.VarChar(1000)
  location      String   @db.VarChar(200)
  whatsIncluded String[] @map("whats_included") @db.VarChar(1000)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@map("event_translations")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Booking {
  id     String @id @default(uuid())
  userId String @map("user_id")

  occurrenceId String @map("occurrence_id")

  status    BookingStatus @default(PENDING)
  expired   Boolean       @default(false)
  quantity  Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  amount Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(SITE_PAYMENT) @map("payment_method")

  createdByAdminId String? @map("created_by_admin_id")

  paymentIntentId String?   @unique @map("payment_intent_id")
  referenceNumber Int?      @unique @map("reference_number")
  checkedInAt     DateTime? @map("checked_in_at")

  user User @relation("user_bookings", fields: [userId], references: [id], onDelete: Cascade)

  occurrence  EventOccurrence     @relation("occurrence_bookings", fields: [occurrenceId], references: [id], onDelete: Cascade)
  adjustments BookingAdjustment[] @relation("booking_adjustments")

  @@unique([userId, occurrenceId])
  @@index([userId])
  @@index([occurrenceId])
  @@map("bookings")
}

model BookingReference {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("booking_references")
}

enum AdjustmentType {
  CHARGE
  REFUND
}

enum AdjustmentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model BookingAdjustment {
  id                    String           @id @default(uuid())
  bookingId             String           @map("booking_id")
  type                  AdjustmentType
  amount                Decimal          @db.Decimal(10, 2)
  currency              String           @default("usd")
  stripePaymentIntentId String?          @unique @map("stripe_payment_intent_id")
  stripeRefundId        String?          @unique @map("stripe_refund_id")
  status                AdjustmentStatus
  reason                String?
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  booking Booking @relation("booking_adjustments", fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_adjustments")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  email         String?   @unique
  name          String
  passwordHash  String?  @map("password_hash")
  image         String?
  role          UserRole @default(USER)
  emailVerified Boolean  @default(false) @map("email_verified")
  isShadow      Boolean  @default(false) @map("is_shadow")
  phone         String?  @map("phone")

  googleId  String?  @unique @map("google_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events        Event[]        @relation("user_events")
  refreshTokens RefreshToken[] @relation("refresh_tokens")

  bookings Booking[] @relation("user_bookings")

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @map("hashed_token")
  userId      String   @map("user_id")
  user        User     @relation("refresh_tokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("refresh_tokens")
}
