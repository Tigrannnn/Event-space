<mj-wrapper padding="0px 20px 40px 20px">
	<mj-section
		background-color="#ffffff"
		border-radius="{{ CARD_RADIUS }}"
		border="{{ CARD_BORDER }}"
		padding="{{ CARD_PADDING }}"
		css-class="card-bg shadow-card"
	>
		<mj-column>
			<mj-text
				align="center"
				font-size="22px"
				font-weight="{{ HEADING_WEIGHT }}"
				font-family="{{ HEADING_FONT }}"
				color="{{ TITLE_COLOR }}"
				padding="0px 0px 8px 0px"
				css-class="text-main"
			>
				{{ TITLE }}
			</mj-text>
			<mj-divider
				border-width="1px"
				border-color="#e5e7eb"
				padding="0px 0px 24px 0px"
				css-class="divider-color"
			/>
			<mj-text
				align="left"
				font-size="15px"
				color="#111827"
				padding="0px 0px 16px 0px"
				css-class="text-main"
			>
				{{ INTRO }}
			</mj-text>
			<mj-table css-class="text-muted" font-size="14px" color="#6b7280" padding="0px 0px 20px 0px">
				{{ DETAILS_ROWS }}
			</mj-table>
			{{ QUOTE_BLOCK }}
			<mj-button
				href="{{ QUEUE_URL }}"
				background-color="{{ BRAND_PRIMARY }}"
				color="#ffffff"
				border-radius="{{ BUTTON_RADIUS }}"
				font-size="15px"
				font-weight="700"
				padding="8px 0px 24px 0px"
				inner-padding="14px 28px"
			>
				{{ BUTTON }}
			</mj-button>
			<mj-text
				align="left"
				font-size="14px"
				color="#6b7280"
				padding="0px"
				css-class="text-muted"
			>
				{{ OUTRO }}
			</mj-text>
		</mj-column>
	</mj-section>
</mj-wrapper>
