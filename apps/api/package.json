{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "dotenv -e ../../.env -- nest start",
		"start:dev": "dotenv -e ../../.env -- nest start --watch",
		"start:debug": "dotenv -e ../../.env -- nest start --debug --watch",
		"start:prod": "dotenv -e ../../.env -- node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "dotenv -e ../../.env -- jest",
		"test:watch": "dotenv -e ../../.env -- jest --watch",
		"test:cov": "dotenv -e ../../.env -- jest --coverage",
		"test:debug": "dotenv -e ../../.env -- node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "dotenv -e ../../.env.test -- jest --config ./test/jest-e2e.json --runInBand",
		"test:e2e:prepare": "dotenv -e ../../.env.test -- npx prisma migrate deploy",
		"prisma:push": "dotenv -e ../../.env -- npx prisma db push",
		"prisma:migrate": "dotenv -e ../../.env -- npx prisma migrate dev",
		"prisma:generate": "dotenv -e ../../.env -- npx prisma generate",
		"prisma:studio": "dotenv -e ../../.env -- npx prisma studio",
		"templates:build": "mjml apps/api/src/infrastructure/mail/templates/*.mjml -o apps/api/src/infrastructure/mail/templates-compiled/"
	},
	"dependencies": {
		"@nestjs-modules/mailer": "^1.11.2",
		"@nestjs/common": "^11.1.18",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.18",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.1.18",
		"@nestjs/swagger": "^11.0.0",
		"@prisma/client": "^6.19.2",
		"@types/mjml": "^4.7.4",
		"bcrypt": "^6.0.0",
		"body-parser": "^2.2.2",
		"cloudinary": "^2.10.0",
		"cookie-parser": "^1.4.7",
		"google-auth-library": "^10.6.2",
		"ioredis": "^5.10.1",
		"mjml": "^4.18.0",
		"multer": "^2.1.1",
		"nodemailer": "^8.0.5",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"resend": "^6.10.0",
		"rxjs": "^7.8.1",
		"streamifier": "^0.1.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.17",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/bcrypt": "^6.0.0",
		"@types/body-parser": "^1.19.6",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/multer": "^2.1.0",
		"@types/node": "^22.10.7",
		"@types/nodemailer": "^8.0.0",
		"@types/passport-jwt": "^4.0.1",
		"@types/streamifier": "^0.1.2",
		"@types/supertest": "^6.0.3",
		"dotenv": "^17.3.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^30.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-prisma": "^5.0.0",
		"prisma": "^6.19.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"zod-prisma-types": "^3.3.11"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
