# Copy to .env.test — used ONLY by e2e (npm run test:e2e)
# Never point this at your development database.

API_PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=test

POSTGRES_USER=postgres
POSTGRES_PASSWORD=event-space-2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=event_space_test

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Logical DB 1 — isolated from dev keys on redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

JWT_ACCESS_SECRET=test-jwt-access-secret
ALLOWED_ORIGINS=http://localhost:3000

MAIL_DEV_MODE=true
GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
